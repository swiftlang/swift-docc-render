{
  "name": "swift-docc-render",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "serve": "vite",
    "build": "vite build && node ./bin/transformIndex.js",
    "test": "pnpm test:unit && pnpm lint && pnpm test:license",
    "test:license": "./bin/check-source",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint app src tests vite.config.mjs vitest.config.mjs",
    "lint:fix": "pnpm lint --fix",
    "docs": "bin/build-and-serve-docs",
    "docs:preview": "bin/build-and-serve-docs",
    "docs:build": "bin/build-docs",
    "docs:serve": "bin/serve-docs"
  },
  "files": [
    "src",
    "index.js",
    "test-utils.js"
  ],
  "dependencies": {
    "@apple/highlightjs-pkl": "^1.0.1",
    "css.escape": "^1.5.1",
    "highlight.js": "^11.11.1",
    "portal-vue": "^3.0.0",
    "vue-i18n": "^11.4.8",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "sass": "^1.102.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-jsdoc": "^0.25.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.0",
    "vue": "3.5.40",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.17.0 <12"
  }
}
