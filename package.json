{
  "name": "swift-docc-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./bin/transformIndex.js",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm lint && pnpm test:license",
    "test:license": "./bin/check-source",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "docs": "bin/build-and-serve-docs",
    "docs:preview": "bin/build-and-serve-docs",
    "docs:build": "bin/build-docs",
    "docs:serve": "bin/serve-docs"
  },
  "files": [
    "src",
    "index.js",
    "test-utils.js"
  ],
  "dependencies": {
    "@apple/highlightjs-pkl": "^1.0.1",
    "css.escape": "^1.5.1",
    "highlight.js": "^11.11.1",
    "portal-vue": "^3.0.0",
    "vue": "3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vitest/ui": "4.1.10",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.76.0",
    "sass": "^1.102.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-jsdoc": "^0.25.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=11.17.0 <12"
  }
}
