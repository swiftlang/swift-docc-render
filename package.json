{
  "name": "swift-docc-render",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./bin/transformIndex.js",
    "preview": "vite preview",
    "test": "run-s test:unit lint test:license",
    "test:license": "./bin/check-source",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "docs": "bin/build-and-serve-docs",
    "docs:preview": "bin/build-and-serve-docs",
    "docs:build": "bin/build-docs",
    "docs:serve": "bin/serve-docs"
  },
  "files": [
    "src",
    "index.js",
    "test-utils.js"
  ],
  "dependencies": {
    "@apple/highlightjs-pkl": "^1.0.1",
    "css.escape": "^1.5.1",
    "highlight.js": "^11.12.0",
    "portal-vue": "^3.0.0",
    "sass-embedded": "^1.105.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.2.0",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.4",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.87.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-jsdoc": "^0.25.0",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.25.0": true,
    "tree-sitter-jsdoc@0.25.0": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
